// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  isVerified           Boolean        @default(false)
  verificationToken    String?        @unique
  resetPasswordToken   String?        @unique
  resetPasswordExpires DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  organizations        UserOrganization[]
  refreshTokens        RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  autoTag   String?
  tagEnabled Boolean           @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  admins    UserOrganization[]
  groups    Group[]
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("admin")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model Group {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  invitations    Invitation[]
  exportTokens   ExportToken[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Invitation {
  id             String   @id @default(cuid())
  slug           String   @unique
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expiresAt      DateTime?
  allowDownload  Boolean  @default(true)
  requiredFields String   @default("firstName,lastName,phone") // JSON: ["firstName","lastName","phone",...]
  allowedContacts InvitationContact[] // Contacts that can be downloaded from this invitation
  createdAt      DateTime @default(now())
}

model InvitationContact {
  id           String   @id @default(cuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([invitationId, contactId])
  @@index([invitationId])
  @@index([contactId])
}

model Contact {
  id             String   @id @default(cuid())
  firstName      String?
  lastName       String?
  phone          String?
  alternatePhone String?
  countryCode    String?  @default("BJ")
  email          String?
  dateOfBirth    DateTime?
  nickname       String?
  tag            String?
  
  // Professional
  organization   String?
  jobTitle       String?
  
  // Location
  address        String?
  city           String?
  country        String?
  
  groupId        String
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitations    InvitationContact[] // Invitations this contact can be downloaded from
  createdAt      DateTime @default(now())

  @@index([groupId])
  @@index([phone])
  @@index([email])
  @@unique([groupId, phone], name: "unique_phone_per_group")
  @@unique([groupId, email], name: "unique_email_per_group")
}

model ExportToken {
  id        String    @id @default(cuid())
  token     String    @unique
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  format    String    @default("vcf")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([groupId])
}